// ------------------------------------------------------------------
// Module 1 : Process Manager
//
// Arguments:
//      R1 - function number
//      R2 - PID of the process being operated on
// Return value:
//      R0
//
// Functions implemented in this stage:
//      2 (FREE_USER_AREA_PAGE) - release the process's user area page
//      3 (EXIT_PROCESS)        - release everything the process owns
//      4 (FREE_PAGE_TABLE)     - release every private page it maps
//
// All three take the PID explicitly and reach the page table through the
// process table rather than through the live PTBR, so they stay correct
// when called for a process other than the running one.
// ------------------------------------------------------------------

alias functionNumber R1;
alias currentPID R2;

if (functionNumber == FREE_USER_AREA_PAGE) then

    alias userAreaPage R3;
    userAreaPage = [PROCESS_TABLE + 16 * currentPID + 11];

    multipush(R1, R2, R3);

    R1 = RELEASE_PAGE;
    R2 = userAreaPage;

    call MOD_2;

    multipop(R1, R2, R3);

    R0 = 0;
    return;

endif;

if (functionNumber == EXIT_PROCESS) then

    multipush(R1, R2);

    // Order matters: the page table has to be walked before it is
    // forgotten, and the user area page is released last because it is
    // still holding the kernel stack we are standing on.
    R1 = FREE_PAGE_TABLE;
    R2 = currentPID;
    call MOD_1;

    R1 = FREE_USER_AREA_PAGE;
    R2 = currentPID;
    call MOD_1;

    multipop(R1, R2);

    [PROCESS_TABLE + 16 * currentPID + 4] = TERMINATED;

    R0 = 0;
    return;

endif;

if (functionNumber == FREE_PAGE_TABLE) then

    alias pageTable R3;
    alias entries R4;

    pageTable = [PROCESS_TABLE + 16 * currentPID + 14];
    entries = [PROCESS_TABLE + 16 * currentPID + 15];

    // Entries 0 and 1 map the shared library. Every process maps the same
    // two physical pages and nobody owns them, so they are unmapped but
    // never released.
    [pageTable + 0] = -1;
    [pageTable + 1] = "0000";
    [pageTable + 2] = -1;
    [pageTable + 3] = "0000";

    alias i R5;
    alias pageNumber R6;

    i = 2;
    while (i < entries) do

        pageNumber = [pageTable + 2 * i];

        if (pageNumber != -1) then

            multipush(R1, R2, R3, R4, R5, R6);

            R1 = RELEASE_PAGE;
            R2 = pageNumber;

            call MOD_2;

            multipop(R1, R2, R3, R4, R5, R6);

            [pageTable + 2 * i] = -1;
            [pageTable + 2 * i + 1] = "0000";

        endif;

        i = i + 1;
    endwhile;

    // Only heap/stack disk blocks are temporary swap storage. Executable
    // code blocks belong to the file and must not be released on exit.
    i = 0;
    while (i < 10) do
        if (i == 2 || i == 3 || i == 8 || i == 9) then
            if ([DISK_MAP_TABLE + currentPID * 10 + i] != -1) then
                multipush(R1, R2, R3, R4, R5, R6);
                R1 = RELEASE_BLOCK;
                R2 = [DISK_MAP_TABLE + currentPID * 10 + i];
                call MOD_2;
                multipop(R1, R2, R3, R4, R5, R6);
            endif;
        endif;
        [DISK_MAP_TABLE + currentPID * 10 + i] = -1;
        i = i + 1;
    endwhile;

    R0 = 0;
    return;

endif;

// Unknown function number for this module.
R0 = -1;
return;
