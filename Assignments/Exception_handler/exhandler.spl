// Save the user context before touching general-purpose registers.
// In --debug mode, inspect EC/EIP/EPN and the page table before recovery.
breakpoint;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = -1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

backup;

multipush(EIP);

if ((EC != 0) || ([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] == (PTLR * 512 - 1))) then
    if (EC == 0) then
        print "Stack full";
    endif;
    if (EC == 1) then
        print "Illegal instr";
    endif;
    if (EC == 2) then
        print "Illegal addr";
    endif;
    if (EC == 3) then
        print "Arithmetic";
    endif;

    R1 = EXIT_PROCESS;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_1;

    call MOD_5;

    // A terminated process must never return through the recovery path.
    halt;
else
    alias blockNumber R2;
    if (EPN > 3 && EPN < 8) then // code page
        blockNumber = [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + EPN];

        if (blockNumber == -1) then
            print "Illegal addr";
            R1 = EXIT_PROCESS;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            call MOD_1;
            call MOD_5;
            halt;
        endif;

        multipush(R0, R1, R2);
        multipush(EPN);
        R1 = GET_CODE_PAGE;
        R2 = blockNumber;
        call MOD_2;

        multipop(EPN);
        [PAGE_TABLE_BASE + [SYSTEM_STATUS_TABLE + 1] * 20 + 2 * EPN] = R0;
        [PAGE_TABLE_BASE + [SYSTEM_STATUS_TABLE + 1] * 20 + 2 * EPN + 1] = "1100";

        multipop(R0, R1, R2);
    else
        // Only logical pages 2 and 3 are demand-allocated heap pages.
        if (EPN != 2 && EPN != 3) then
            print "Illegal addr";
            R1 = EXIT_PROCESS;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            call MOD_1;
            call MOD_5;
            halt;
        endif;
        multipush(R0, R1, R2);

        R1 = GET_FREE_PAGE;
        call MOD_2;
        [PTBR + 4] = R0;
        [PTBR + 5] = "1110";

        R1 = GET_FREE_PAGE;
        call MOD_2;
        [PTBR + 6] = R0;
        [PTBR + 7] = "1110";

        multipop(R0, R1, R2);
    endif;
endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

multipop(EIP);

// Inspect the repaired mapping and saved EIP before returning to user mode.
breakpoint;
restore;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
SP = SP + 1;

// Exceptions do not push a return address. Retry EIP, not EIP + 2.
[[PTBR + 2 * (SP / 512)] * 512 + (SP % 512)] = EIP;

ireturn;
