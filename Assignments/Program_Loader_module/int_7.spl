// ------------------------------------------------------------------
// INT 7 : Write system call
//
//      User stack on entry:
//          userSP - 4 : file descriptor  (-2 => terminal)
//          userSP - 3 : word to be written
//          userSP - 1 : return value slot
//
// The actual printing is no longer done here. The word is handed over
// to Terminal Write (function 3) of the Device Manager (Module 4),
// which serialises access to the terminal through the Resource Manager.
// ------------------------------------------------------------------

// Mark the process as executing system call number 5 (Write)
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 5;

alias userSP R0;
userSP = SP;

// Save the user stack pointer in UPTR
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = userSP;

// Switch to the kernel stack of the process
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

PTBR = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 14];

alias physicalPageNum R1;
alias offset R2;
alias fileDescriptor R3;

physicalPageNum = [PTBR + 2 * ((userSP - 4) / 512)];
offset = (userSP - 4) % 512;
fileDescriptor = [physicalPageNum * 512 + offset];

if (fileDescriptor != -2) then

    // Only the terminal is supported at this stage.
    physicalPageNum = [PTBR + 2 * ((userSP - 1) / 512)];
    offset = (userSP - 1) % 512;
    [physicalPageNum * 512 + offset] = -1;

else

    alias word R4;
    physicalPageNum = [PTBR + 2 * ((userSP - 3) / 512)];
    offset = (userSP - 3) % 512;
    word = [physicalPageNum * 512 + offset];

    // ---- Invoke Terminal Write (Module 4, function 3) ----
    multipush(R0, R1, R2, R3, R4);

    R1 = TERMINAL_WRITE;                    // function number
    R2 = [SYSTEM_STATUS_TABLE + 1];         // PID of the current process
    R3 = word;                              // word to be printed

    call MOD_4;

    // Terminal Write has no meaningful return value - R0 is ignored.
    multipop(R0, R1, R2, R3, R4);

    // The process may have been rescheduled inside Module 0, so PTBR is
    // recomputed here (the scheduler restores it, this is just explicit).
    PTBR = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 14];

    physicalPageNum = [PTBR + 2 * ((userSP - 1) / 512)];
    offset = (userSP - 1) % 512;
    [physicalPageNum * 512 + offset] = 0;

endif;

// Switch back to the user stack and return to user mode
SP = userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;
