// ------------------------------------------------------------------
// Module 7 : Boot Module
//
// loadi(memory_page, disk_block)
//
// Only IDLE (PID 0) and INIT (PID 1) run in this stage - INIT is the
// process that reads from the console, IDLE is the process that keeps
// the machine in user mode while INIT sleeps in WAIT_TERMINAL.
// ------------------------------------------------------------------

// load exception handler from disk blocks 15-16 to memory pages 2-3
loadi(2, 15);
loadi(3, 16);

// load timer interrupt from disk blocks 17-18 to memory pages 4-5
loadi(4, 17);
loadi(5, 18);

// load console interrupt handler from disk blocks 21-22 to memory pages 8-9
loadi(8, 21);
loadi(9, 22);

// load int 6 (Read) from disk blocks 27-28 to memory pages 14-15
loadi(14, 27);
loadi(15, 28);

// load int 7 (Write) from disk blocks 29-30 to memory pages 16-17
loadi(16, 29);
loadi(17, 30);

// load int 10 (Exit) from disk blocks 35-36 to memory pages 22-23
loadi(22, 35);
loadi(23, 36);

// load module 0 (resource manager) from disk blocks 53-54 to memory pages 40-41
loadi(40, 53);
loadi(41, 54);

// load module 4 (device manager) from disk blocks 61-62 to memory pages 48-49
loadi(48, 61);
loadi(49, 62);

// load module 5 (scheduler) from disk blocks 63-64 to memory pages 50-51
loadi(50, 63);
loadi(51, 64);

// load library code from disk blocks 13-14 to memory pages 63-64
loadi(63, 13);
loadi(64, 14);

// load init code from disk blocks 7-8 to memory pages 65-66
loadi(65, 7);
loadi(66, 8);

// For INIT
PTBR = PAGE_TABLE_BASE + 20;
PTLR = 10;

// Initialize the page table for INIT program
// library
[PTBR + 0] = 63;
[PTBR + 1] = "0100";
[PTBR + 2] = 64;
[PTBR + 3] = "0100";

// Heap
[PTBR + 4] = 84;
[PTBR + 5] = "0110";
[PTBR + 6] = 85;
[PTBR + 7] = "0110";

// code
[PTBR + 8] = 65;
[PTBR + 9] = "0100";
[PTBR + 10] = 66;
[PTBR + 11] = "0100";
[PTBR + 12] = -1;
[PTBR + 13] = "0000";
[PTBR + 14] = -1;
[PTBR + 15] = "0000";

// Stack
[PTBR + 16] = 76;
[PTBR + 17] = "0110";
[PTBR + 18] = 77;
[PTBR + 19] = "0110";

// setting up process table for INIT
[PROCESS_TABLE + 16 + 1] = 1;
[PROCESS_TABLE + 16 + 4] = CREATED;
[PROCESS_TABLE + 16 + 11] = 80;
[PROCESS_TABLE + 16 + 13] = 8 * 512;
[PROCESS_TABLE + 16 + 12] = 0;
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE + 20;
[PROCESS_TABLE + 16 + 15] = 10;

[76 * 512] = [65 * 512 + 1];

// Every other slot in the process table is free.
alias i R0;
i = 2;
while (i < MAX_PROC_NUM) do
    [PROCESS_TABLE + i * 16 + 4] = TERMINATED;
    i = i + 1;
endwhile;

// Terminal Status Table - the terminal is free before the first process runs
[TERMINAL_STATUS_TABLE] = 0;
[TERMINAL_STATUS_TABLE + 1] = -1;

return;
