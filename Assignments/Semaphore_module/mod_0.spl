// ------------------------------------------------------------------
// Module 0 : Resource Manager
// Based on Disk_Interrupt_Handler/mod_0.spl.
//
// Arguments (SPL module calling convention):
//      R1 - function number
//      R2 - PID, except Release Semaphore: global semaphore index
//      R3 - Release Semaphore only: PID of the releasing process
// Return value:
//      R0
//
// Functions implemented so far:
//      3 (ACQUIRE_DISK)      - lock the disk for the given process
//      6 (ACQUIRE_SEMAPHORE) - allocate a semaphore; return its global
//                            table index, or -1 if the table is full
//      7 (RELEASE_SEMAPHORE) - detach one reference; unlock if owned
//      8 (ACQUIRE_TERMINAL)  - lock the terminal for the given process
//      9 (RELEASE_TERMINAL)  - unlock the terminal and wake up waiters
// ------------------------------------------------------------------

alias functionNum R1;
alias currentPID R2;
alias returnValue R0;

if (functionNum == ACQUIRE_SEMAPHORE) then

    alias semaphoreIndex R3;
    semaphoreIndex = 0;

    while (semaphoreIndex < MAX_SEM_COUNT) do
        // PROCESS COUNT == 0 is the definition of a free entry.
        if ([SEMAPHORE_TABLE + semaphoreIndex * 4] == 0) then
            [SEMAPHORE_TABLE + semaphoreIndex * 4] = 1;
            [SEMAPHORE_TABLE + semaphoreIndex * 4 + 1] = -1;

            // Acquiring a semaphore does not lock it. SemLock does that.
            // Return the global index; Semget will create the descriptor.
            returnValue = semaphoreIndex;
            return;
        endif;
        semaphoreIndex = semaphoreIndex + 1;
    endwhile;

    // All 32 entries are allocated.
    returnValue = -1;
    return;

endif;

if (functionNum == RELEASE_SEMAPHORE) then

    // Module callers supply a valid global index and a PID that holds
    // a reference. Semrelease validates the user descriptor first.
    alias semaphoreToRelease R2;
    alias releasingPID R3;
    alias semaphoreEntry R4;
    alias waitingPID R5;
    alias waitingEntry R6;

    semaphoreEntry = SEMAPHORE_TABLE + semaphoreToRelease * 4;
    if ([semaphoreEntry + 1] == releasingPID) then
        [semaphoreEntry + 1] = -1;

        // Wake only processes waiting for THIS semaphore. They will
        // recheck the lock when scheduled; READY does not grant ownership.
        waitingPID = 0;
        while (waitingPID < MAX_PROC_NUM) do
            waitingEntry = PROCESS_TABLE + waitingPID * 16;
            if ([waitingEntry + 4] == WAIT_SEMAPHORE && [waitingEntry + 5] == semaphoreToRelease) then
                [waitingEntry + 4] = READY;
            endif;
            waitingPID = waitingPID + 1;
        endwhile;
    endif;

    // A non-owner may detach its reference without disturbing the owner.
    // Count zero makes this entry available to Acquire Semaphore again.
    [semaphoreEntry] = [semaphoreEntry] - 1;
    returnValue = 0;
    return;

endif;

if (functionNum == ACQUIRE_TERMINAL) then

    // Wait until the terminal becomes free, yielding the CPU while busy.
    // STATUS (word 0 of the Terminal Status Table) is 1 when the
    // terminal is held by some process, 0 when it is free.
    while ([TERMINAL_STATUS_TABLE] != 0) do

        // Give up the CPU. The scheduler will run this process again
        // only after somebody releases the terminal, but the terminal
        // may have been grabbed by another woken up process by then -
        // hence the loop and not a single wait.
        [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_TERMINAL;

        multipush(R1, R2);

        call MOD_5;

        multipop(R1, R2);

    endwhile;

    // Terminal is free - take it.
    [TERMINAL_STATUS_TABLE] = 1;
    [TERMINAL_STATUS_TABLE + 1] = currentPID;

    returnValue = 0;
    return;

else

    if (functionNum == RELEASE_TERMINAL) then

        // A process may release the terminal only if it holds it.
        if (currentPID != [TERMINAL_STATUS_TABLE + 1]) then
            returnValue = -1;
            return;
        else

            [TERMINAL_STATUS_TABLE] = 0;

            // Wake up every process blocked on the terminal. For a read
            // this is what un-blocks the process that issued the IN
            // instruction and is now sitting in WAIT_TERMINAL.
            alias i R3;
            i = 0;
            while (i < MAX_PROC_NUM) do
                if ([PROCESS_TABLE + i * 16 + 4] == WAIT_TERMINAL) then
                    [PROCESS_TABLE + i * 16 + 4] = READY;
                endif;
                i = i + 1;
            endwhile;

            returnValue = 0;
            return;

        endif;

    else
        if (functionNum == ACQUIRE_DISK) then
            while ([DISK_STATUS_TABLE] == 1) do

                [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_DISK;
                multipush(R1, R2);
                call MOD_5;
                multipop(R1, R2);

            endwhile;

            [DISK_STATUS_TABLE] = 1;
            [DISK_STATUS_TABLE + 4] = currentPID;
            returnValue = 0;
            return;
        else
            // Unknown function number for this module.
            returnValue = -1;
            return;
        endif;
    endif;

endif;
